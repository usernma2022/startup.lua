local detector = peripheral.find("playerDetector")

if not detector then
    error("Player Detector not found")
end

local MY_USERNAME = "Usernam_"
local RANGE = 192
local UPDATE_TIME = 0.25

local target = nil
local targets = {}
local showControls = false

local w,h = term.getSize()

local function validPosition(data)
    return data and data.x and data.y and data.z
end

local function distance(a,b)
    if not validPosition(a) or not validPosition(b) then
        return math.huge
    end

    local dx = a.x-b.x
    local dy = a.y-b.y
    local dz = a.z-b.z

    return math.sqrt(dx*dx+dy*dy+dz*dz)
end

local function normalizeAngle(angle)
    while angle > 180 do
        angle = angle-360
    end

    while angle < -180 do
        angle = angle+360
    end

    return angle
end

local function getSelf()
    local data = detector.getPlayerPos(MY_USERNAME)

    if validPosition(data) then
        return data
    end

    return nil
end

local function refreshTargets()

    local self = getSelf()

    if not self then
        targets = {}
        return
    end

    local newTargets = {}

    for _,player in ipairs(detector.getOnlinePlayers()) do

        if player ~= MY_USERNAME then

            local data = detector.getPlayerPos(player)

            if validPosition(data) then

                local dist = distance(self,data)

                if dist <= RANGE then

                    table.insert(newTargets,{
                        name = player,
                        data = data,
                        distance = dist
                    })

                end
            end
        end
    end

    table.sort(newTargets,function(a,b)
        return a.distance < b.distance
    end)

    targets = newTargets
end

local function selectClosest()

    if not target and targets[1] then
        target = targets[1].name
    end

end

local function cycleTarget(direction)

    if #targets == 0 then
        return
    end

    local index = 1

    for i,v in ipairs(targets) do
        if v.name == target then
            index=i
            break
        end
    end

    index=index+direction

    if index>#targets then
        index=1
    elseif index<1 then
        index=#targets
    end

    target=targets[index].name
end

local function getDirection(player,targetData)

    local dx = targetData.x-player.x
    local dz = targetData.z-player.z

    local angle = math.deg(math.atan2(-dx,dz))
    local diff = normalizeAngle(angle-player.yaw)

    if diff > -45 and diff < 45 then
        return " | "
    elseif diff >=45 and diff <135 then
        return " -"
    elseif diff <=-45 and diff >-135 then
        return "- "
    else
        return " || "
    end
end

local function drawCompass(self,targetData)

    if not validPosition(targetData) then
        return
    end

    local midX = math.floor(w/2)
    local midY = math.floor(h/2)

    term.setCursorPos(midX,midY)
    term.setTextColor(colors.red)

    write("O")

    local dir = getDirection(self,targetData)

    if dir==" | " then
        term.setCursorPos(midX,midY-1)
        write("|")
        term.setCursorPos(midX,midY-2)
        write("|")

    elseif dir==" - " then
        term.setCursorPos(midX+1,midY)
        write("-")
        term.setCursorPos(midX+2,midY)
        write("-")

    elseif dir=="- " then
        term.setCursorPos(midX-1,midY)
        write("-")
        term.setCursorPos(midX-2,midY)
        write("-")

    else
        term.setCursorPos(midX,midY-1)
        write("|")
    end

end

local function draw()

    term.clear()
    term.setCursorPos(1,1)

    local self=getSelf()

    if not self then
        term.setTextColor(colors.red)
        print("SELF NOT FOUND")
        return
    end

    local targetData=nil

    if target then
        targetData=detector.getPlayerPos(target)
    end


    if validPosition(targetData) then

        local dist=math.floor(distance(self,targetData))
        local height=math.floor(targetData.y-self.y)

        term.setTextColor(colors.white)
        write(target)

        term.setTextColor(colors.cyan)
        write(" "..dist.."m")

        term.setTextColor(colors.yellow)

        if height>=0 then
            write(" +"..height)
        else
            write(" "..height)
        end

        term.setTextColor(colors.green)
        write(" LOCK")

    elseif target then

        term.setTextColor(colors.red)
        write(target.." LOST")

    else

        term.setTextColor(colors.red)
        write("NO TARGET")

    end


    term.setTextColor(colors.gray)
    write(" | H Controls")


    if showControls then

        term.setCursorPos(1,3)

        print("+----------+")
        print("| Z Prev   |")
        print("| X Next   |")
        print("| H Hide   |")
        print("+----------+")

    end


    drawCompass(self,targetData)

end


local function updater()

    while true do
        refreshTargets()
        selectClosest()
        draw()

        sleep(UPDATE_TIME)
    end

end


local function controls()

    while true do

        local event,key=os.pullEvent("key")

        if key==keys.x then
            cycleTarget(1)

        elseif key==keys.z then
            cycleTarget(-1)

        elseif key==keys.h then
            showControls=not showControls
        end

    end

end


parallel.waitForAny(
    updater,
    controls
)
