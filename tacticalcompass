-- AEGIS Target Computer V1

local detector = peripheral.find("playerDetector")

if not detector then
    error("Player Detector not found")
end

local MY_USERNAME = "YourUsername"
local RANGE = 192

local target = nil
local targets = {}
local showControls = false

local w, h = term.getSize()

local function distance(a, b)
    local dx = a.x - b.x
    local dy = a.y - b.y
    local dz = a.z - b.z
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function normalizeAngle(angle)
    while angle > 180 do
        angle = angle - 360
    end
    while angle < -180 do
        angle = angle + 360
    end
    return angle
end

local function getSelf()
    return detector.getPlayerPos(MY_USERNAME)
end

local function refreshTargets()
    local self = getSelf()
    if not self then
        return
    end

    local newTargets = {}

    for _, player in ipairs(detector.getOnlinePlayers()) do
        if player ~= MY_USERNAME then
            local data = detector.getPlayerPos(player)

            if data then
                local dist = distance(self, data)

                if dist <= RANGE then
                    table.insert(newTargets, {
                        name = player,
                        data = data,
                        distance = dist
                    })
                end
            end
        end
    end

    table.sort(newTargets, function(a, b)
        return a.distance < b.distance
    end)

    targets = newTargets
end

local function selectClosest()
    if targets[1] then
        target = targets[1].name
    end
end

local function cycleTarget(direction)
    if #targets == 0 then
        return
    end

    local index = 1

    for i, player in ipairs(targets) do
        if player.name == target then
            index = i
            break
        end
    end

    index = index + direction

    if index > #targets then
        index = 1
    elseif index < 1 then
        index = #targets
    end

    target = targets[index].name
end

local function getArrow(player, enemy)

    local dx = enemy.x - player.x
    local dz = enemy.z - player.z

    local targetYaw = math.deg(math.atan2(-dx, dz))

    local difference = normalizeAngle(targetYaw - player.yaw)

    if difference >= -22.5 and difference <= 22.5 then
        return "▲"
    elseif difference > 22.5 and difference < 67.5 then
        return "◢"
    elseif difference >= 67.5 and difference <= 112.5 then
        return "►"
    elseif difference > 112.5 and difference < 157.5 then
        return "◥"
    elseif difference >= 157.5 or difference <= -157.5 then
        return "▼"
    elseif difference < -112.5 and difference > -157.5 then
        return "◤"
    elseif difference <= -67.5 and difference >= -112.5 then
        return "◄"
    else
        return "◣"
    end
end

local function draw()

    term.clear()
    term.setCursorPos(1, 1)

    local self = getSelf()

    if not self then
        print("SELF NOT FOUND")
        return
    end

    local targetData = nil

    if target then
        targetData = detector.getPlayerPos(target)
    end

    if targetData then

        local dist = math.floor(distance(self, targetData))
        local height = math.floor(targetData.y - self.y)

        write(target)
        
        term.setTextColor(colors.cyan)
        write(" "..dist.."m")

        term.setTextColor(colors.yellow)

        if height > 0 then
            write(" ▲"..height)
        elseif height < 0 then
            write(" ▼"..math.abs(height))
        else
            write(" --")
        end

        term.setTextColor(colors.green)
        write(" LOCK")

    elseif target then

        term.setTextColor(colors.white)
        write(target)

        term.setTextColor(colors.red)
        write(" LOST | LOST")

    else

        term.setTextColor(colors.red)
        write("NO TARGET")

    end

    term.setTextColor(colors.gray)
    write(" | H Controls")


    if showControls then

        term.setCursorPos(w - 12, 3)

        term.setTextColor(colors.white)

        print("+----------+")
        print("| Z Prev   |")
        print("| X Next   |")
        print("| H Hide   |")
        print("+----------+")

    end


    if targetData then

        local arrow = getArrow(self, targetData)

        term.setCursorPos(
            math.floor(w / 2),
            math.floor(h / 2)
        )

        term.setTextColor(colors.red)
        write(arrow)

    end

    term.setTextColor(colors.white)
end


refreshTargets()
selectClosest()
draw()

while true do

    local event, key = os.pullEvent("key")

    if key == keys.x then
        cycleTarget(1)

    elseif key == keys.z then
        cycleTarget(-1)

    elseif key == keys.h then
        showControls = not showControls
    end

    refreshTargets()
    draw()

end
