--to test my own security system and maybe spoof others
local original = peripheral.wrap("left")
local clone = peripheral.wrap("right")

if not original or not clone then
    error("Both drives required")
end

local function readDir(path)
    local data = {}

    for _,name in ipairs(fs.list(path)) do
        local full = fs.combine(path,name)

        if fs.isDir(full) then
            data[name] = {
                dir = true,
                files = readDir(full)
            }
        else
            local f = fs.open(full,"rb")
            data[name] = {
                dir = false,
                data = f.readAll()
            }
            f.close()
        end
    end

    return data
end

local function writeDir(path,data)
    fs.makeDir(path)

    for name,item in pairs(data) do
        local full = fs.combine(path,name)

        if item.dir then
            writeDir(full,item.files)
        else
            local f = fs.open(full,"wb")
            f.write(item.data)
            f.close()
        end
    end
end

print("Insert ORIGINAL into LEFT")
while not original.isDiskPresent() do
    sleep(0.1)
end

print("Reading original...")
local data = readDir(original.getMountPath())

print("Insert CLONE into RIGHT")
while not clone.isDiskPresent() do
    sleep(0.1)
end

print("Writing clone...")
writeDir(clone.getMountPath(),data)

print("Done!")
