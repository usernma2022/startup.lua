

local INPUT_DOWN = "front"
local INPUT_UP = "back"
local OUTPUT = "bottom"
local TANK = "right"
local SPEAKER = "left"

local MIN_THRUST = 0
local MAX_THRUST = 15
local ADJUST_DELAY = 0.2
local FUEL_SAMPLE_INTERVAL = 5
local LOW_FUEL_THRESHOLD = 4000

local ALERT_VOLUME = 3
local ALERT_PITCH_LOW = 0.7
local ALERT_PITCH_HIGH = 1.5
local ALERT_TONE_DELAY = 0.35

local thrust = 0
local lastAdjust = 0
local fuelAmount = nil
local fuelCapacity = nil
local fuelRate = 0
local previousAmount = nil
local previousSampleTime = nil
local tankError = nil
local speakerError = nil
local lowFuelAlertActive = false
local alarmTone = false

local function getPeripheral(side)
    if peripheral.isPresent(side) then
        return peripheral.wrap(side)
    end
    return nil
end

local speaker = getPeripheral(SPEAKER)

local function findFuelData(data, depth)
    if type(data) ~= "table" or depth > 6 then
        return nil, nil
    end

    local amountKeys = {
        amount = true,
        amountintank = true,
        fluidamount = true,
        currentamount = true,
        quantity = true,
        stored = true
    }

    local capacityKeys = {
        capacity = true,
        maxamount = true,
        maxcapacity = true,
        tankcapacity = true,
        maxstored = true
    }

    local amount, capacity

    for key, value in pairs(data) do
        if type(key) == "string" and type(value) == "number" then
            local normalized = string.lower(key):gsub("[_%s%-]", "")

            if amountKeys[normalized] then
                amount = value
            elseif capacityKeys[normalized] then
                capacity = value
            end
        end
    end

    if amount ~= nil then
        return amount, capacity
    end

    for _, value in pairs(data) do
        if type(value) == "table" then
            local nestedAmount, nestedCapacity =
                findFuelData(value, depth + 1)

            if nestedAmount ~= nil then
                return nestedAmount, nestedCapacity
            end
        end
    end

    return nil, nil
end

local function callTank(method, ...)
    if not peripheral.isPresent(TANK) then
        return nil
    end

    local ok, result = pcall(peripheral.call, TANK, method, ...)

    if ok then
        return result
    end

    return nil
end

local function readFuel()
    if not peripheral.isPresent(TANK) then
        tankError = "No tank on right"
        return nil, nil
    end

    local methods = {
        "getInfo",
        "getTankInfo",
        "getTanks",
        "tanks",
        "getFluid",
        "getFluidInTank",
        "getContents",
        "getFluidAmount",
        "getAmount",
        "getStored"
    }

    for _, method in ipairs(methods) do
        local result = callTank(method)
        local amount, capacity = findFuelData(result, 0)

        if amount == nil and type(result) == "number" then
            amount = result
        end

        if amount == nil then
            for index = 1, 4 do
                result = callTank(method, index)
                amount, capacity = findFuelData(result, 0)

                if amount == nil and type(result) == "number" then
                    amount = result
                end

                if amount ~= nil then
                    break
                end
            end
        end

        if amount ~= nil then
            if capacity == nil then
                local capacityMethods = {
                    "getCapacity",
                    "getTankCapacity",
                    "getMaxAmount"
                }

                for _, capacityMethod in ipairs(capacityMethods) do
                    local value = callTank(capacityMethod)

                    if type(value) == "number" then
                        capacity = value
                        break
                    end
                end
            end

            tankError = nil
            return amount, capacity
        end
    end

    tankError = "Unsupported tank reading API"
    return nil, nil
end

local function updateThrust()
    redstone.setAnalogOutput(OUTPUT, thrust)
end

local function sampleFuel()
    local now = os.clock()
    local amount, capacity = readFuel()

    if amount == nil then
        fuelAmount = nil
        fuelCapacity = nil
        return
    end

    fuelAmount = amount
    fuelCapacity = capacity

    if amount < LOW_FUEL_THRESHOLD then
        lowFuelAlertActive = true
    else
        lowFuelAlertActive = false
    end

    if previousAmount ~= nil and previousSampleTime ~= nil then
        local elapsed = now - previousSampleTime
        local consumed = previousAmount - amount

        if elapsed > 0 and consumed > 0 then
            local measuredRate = consumed / elapsed

            if fuelRate <= 0 then
                fuelRate = measuredRate
            else
                fuelRate = fuelRate * 0.7 + measuredRate * 0.3
            end
        elseif consumed < 0 then
            fuelRate = 0
        end
    end

    previousAmount = amount
    previousSampleTime = now
end

local function playAlarmTone(pitch)
    if not speaker then
        speaker = getPeripheral(SPEAKER)
    end

    if not speaker then
        speakerError = "No speaker on left"
        return
    end

    local ok, err = pcall(
        speaker.playSound,
        "minecraft:block.note_block.pling",
        ALERT_VOLUME,
        pitch
    )

    if not ok then
        speakerError = tostring(err)
    else
        speakerError = nil
    end
end

local function alarmLoop()
    while true do
        if lowFuelAlertActive then
            alarmTone = not alarmTone

            if alarmTone then
                playAlarmTone(ALERT_PITCH_HIGH)
            else
                playAlarmTone(ALERT_PITCH_LOW)
            end

            sleep(ALERT_TONE_DELAY)
        else
            alarmTone = false
            sleep(0.1)
        end
    end
end

local function formatTime(seconds)
    if seconds == nil or seconds < 0 then
        return "Unknown"
    end

    local total = math.floor(seconds)
    local hours = math.floor(total / 3600)
    local minutes = math.floor((total % 3600) / 60)
    local secs = total % 60

    if hours > 0 then
        return string.format("%dh %02dm", hours, minutes)
    elseif minutes > 0 then
        return string.format("%dm %02ds", minutes, secs)
    end

    return string.format("%ds", secs)
end

local function drawStatus()
    term.setBackgroundColor(colors.black)
    term.setTextColor(colors.white)
    term.clear()
    term.setCursorPos(1, 1)

    print("AEGIS FLIGHT COMPUTER")
    print("---------------------")
    print("Thrust: " .. thrust .. "/" .. MAX_THRUST)
    print("Output: " .. OUTPUT)
    print("")
    print("CONTROLS")
    print("Front: Shift / decrease")
    print("Back:  Jump / increase")
    print("")
    print("FUEL MONITOR")

    if fuelAmount ~= nil then
        if fuelCapacity ~= nil then
            print(string.format(
                "Fuel: %.1f / %.1f",
                fuelAmount,
                fuelCapacity
            ))

            if fuelCapacity > 0 then
                print(string.format(
                    "Tank: %.1f%%",
                    fuelAmount / fuelCapacity * 100
                ))
            end
        else
            print(string.format("Fuel: %.1f units", fuelAmount))
        end

        if lowFuelAlertActive then
            term.setTextColor(colors.red)
            print("!!! LOW FUEL - ALARM ACTIVE !!!")
            term.setTextColor(colors.white)
        else
            print("Fuel warning: Armed")
        end

        if fuelRate > 0 then
            print(string.format(
                "Use: %.2f units/sec",
                fuelRate
            ))
            print("Remaining: " ..
                formatTime(fuelAmount / fuelRate))
        else
            print("Use: measuring...")
            print("Remaining: Unknown")
        end
    else
        print("Fuel: unavailable")
        print(tankError or "Check tank peripheral")
    end

    if speakerError then
        print("")
        print("SPEAKER: " .. speakerError)
    end

    print("")
    print("Ctrl+T to stop")
end

local function controlLoop()
    updateThrust()
    sampleFuel()

    local nextSample = os.clock() + FUEL_SAMPLE_INTERVAL
    local nextDisplay = 0

    while true do
        local now = os.clock()
        local down = redstone.getInput(INPUT_DOWN)
        local up = redstone.getInput(INPUT_UP)

        if down and not up and now - lastAdjust >= ADJUST_DELAY then
            thrust = math.max(MIN_THRUST, thrust - 1)
            lastAdjust = now
            updateThrust()
        elseif up and not down and now - lastAdjust >= ADJUST_DELAY then
            thrust = math.min(MAX_THRUST, thrust + 1)
            lastAdjust = now
            updateThrust()
        end

        if now >= nextSample then
            sampleFuel()
            nextSample = now + FUEL_SAMPLE_INTERVAL
        end

        if now >= nextDisplay then
            drawStatus()
            nextDisplay = now + 0.5
        end

        sleep(0.05)
    end
end

local ok, err = pcall(function()
    parallel.waitForAny(controlLoop, alarmLoop)
end)

redstone.setAnalogOutput(OUTPUT, 0)

if not ok then
    term.setTextColor(colors.red)
    print("Flight computer stopped:")
    print(tostring(err))
end
