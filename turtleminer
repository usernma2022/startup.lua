
-- AEGIS Diamond Scout v1.0
-- Requires a mining turtle and an Advanced Peripherals Geo Scanner.
-- Scans for diamond ore for 30 seconds, then reverses its recorded route.

local RUN_TIME = 30
local SCAN_RADIUS = 8
local MIN_FUEL = 64
local MAX_MOVE_RETRIES = 8

local started = os.epoch("utc")
local route = {}
local mined = 0
local scans = 0

local function log(message)
    print("[" .. textutils.formatTime(os.time(), true) .. "] " .. message)
end

local function findScanner()
    for _, name in ipairs(peripheral.getNames()) do
        local ok, p = pcall(peripheral.wrap, name)

        if ok and p then
            local methods = peripheral.getMethods(name) or {}
            local hasScan = false

            for _, method in ipairs(methods) do
                if method == "scanBlocks" or method == "scan" then
                    hasScan = true
                    break
                end
            end

            if hasScan then
                return p, name
            end
        end
    end

    return nil, nil
end

local scanner, scannerName = findScanner()

if not scanner then
    print("ERROR: No Geo Scanner peripheral found.")
    print("Check that the scanner is attached and visible.")
    return
end

local function inventoryFull()
    for slot = 1, 16 do
        if turtle.getItemSpace(slot) > 0 then
            return false
        end
    end
    return true
end

local function record(action)
    route[#route + 1] = action
end

local function turnLeft()
    if turtle.turnLeft() then
        record("left")
        return true
    end
    return false
end

local function turnRight()
    if turtle.turnRight() then
        record("right")
        return true
    end
    return false
end

local function turnAround()
    return turnRight() and turnRight()
end

local function moveForward()
    for _ = 1, MAX_MOVE_RETRIES do
        if turtle.forward() then
            record("forward")
            return true
        end

        if turtle.detect() then
            if not turtle.dig() then
                log("Cannot dig the block ahead.")
                return false
            end
            sleep(0.2)
        else
            turtle.attack()
            sleep(0.2)
        end
    end

    log("Could not move forward.")
    return false
end

local function moveVertical(direction)
    for _ = 1, MAX_MOVE_RETRIES do
        local moved

        if direction == "up" then
            moved = turtle.up()
        else
            moved = turtle.down()
        end

        if moved then
            record(direction)
            return true
        end

        local detected
        if direction == "up" then
            detected = turtle.detectUp()
            if detected then
                turtle.digUp()
            else
                turtle.attackUp()
            end
        else
            detected = turtle.detectDown()
            if detected then
                turtle.digDown()
            else
                turtle.attackDown()
            end
        end

        sleep(0.2)
    end

    log("Could not move " .. direction .. ".")
    return false
end

local function moveAxis(axis, amount)
    if amount == 0 then
        return true
    end

    local direction = amount > 0 and 1 or -1
    local count = math.abs(amount)

    if axis == "u" then
        for _ = 1, count do
            if not moveVertical(direction > 0 and "up" or "down") then
                return false
            end
        end
        return true
    end

    if axis == "f" and direction < 0 then
        if not turnAround() then return false end
        for _ = 1, count do
            if not moveForward() then return false end
        end
        return turnAround()
    end

    if axis == "r" then
        if direction > 0 then
            if not turnRight() then return false end
        else
            if not turnLeft() then return false end
        end

        for _ = 1, count do
            if not moveForward() then return false end
        end

        if direction > 0 then
            return turnLeft()
        else
            return turnRight()
        end
    end

    for _ = 1, count do
        if not moveForward() then
            return false
        end
    end

    return true
end

local function scanForDiamonds()
    local scanMethod = scanner.scanBlocks or scanner.scan

    local ok, result, err = pcall(scanMethod, SCAN_RADIUS)

    if not ok then
        log("Scanner error: " .. tostring(result))
        return nil
    end

    if type(result) ~= "table" then
        log("Scan unavailable: " .. tostring(err or result))
        return nil
    end

    scans = scans + 1
    local targets = {}

    for _, block in pairs(result) do
        if type(block) == "table" and type(block.name) == "string" then
            local isDiamond =
                block.name == "minecraft:diamond_ore" or
                block.name == "minecraft:deepslate_diamond_ore"

            if isDiamond then
                -- Modern Geo Scanner results use relative forward/right/up.
                -- x/y/z are used as a fallback for older API versions.
                local f = tonumber(block.f) or tonumber(block.x)
                local r = tonumber(block.r) or tonumber(block.z)
                local u = tonumber(block.u) or tonumber(block.y)

                if f and r and u then
                    targets[#targets + 1] = {
                        name = block.name,
                        f = math.floor(f),
                        r = math.floor(r),
                        u = math.floor(u),
                        distance = math.abs(f) + math.abs(r) + math.abs(u)
                    }
                end
            end
        end
    end

    table.sort(targets, function(a, b)
        return a.distance < b.distance
    end)

    return targets
end

local function mineTarget(target)
    log("Diamond detected: " .. target.name)
    log(("Relative position f=%d r=%d u=%d"):format(
        target.f, target.r, target.u
    ))

    if inventoryFull() then
        log("Inventory full. Returning home.")
        return false
    end

    -- Travel through the target block so the turtle digs it.
    if not moveAxis("f", target.f) then return false end
    if not moveAxis("r", target.r) then return false end
    if not moveAxis("u", target.u) then return false end

    mined = mined + 1
    log("Reached target location. Rescanning.")
    return true
end

local function reverseRoute()
    log("Returning along recorded route...")

    for i = #route, 1, -1 do
        local action = route[i]
        local ok = false

        if action == "left" then
            ok = turtle.turnRight()
        elseif action == "right" then
            ok = turtle.turnLeft()
        elseif action == "forward" then
            -- Usually the path is clear, but falling blocks may obstruct it.
            ok = turtle.back()

            if not ok then
                turtle.turnRight()
                turtle.turnRight()

                for _ = 1, MAX_MOVE_RETRIES do
                    if turtle.forward() then
                        ok = true
                        break
                    end

                    if turtle.detect() then
                        turtle.dig()
                    else
                        turtle.attack()
                    end

                    sleep(0.2)
                end

                turtle.turnRight()
                turtle.turnRight()
            end
        elseif action == "up" then
            for _ = 1, MAX_MOVE_RETRIES do
                if turtle.down() then
                    ok = true
                    break
                end
                if turtle.detectDown() then
                    turtle.digDown()
                else
                    turtle.attackDown()
                end
                sleep(0.2)
            end
        elseif action == "down" then
            for _ = 1, MAX_MOVE_RETRIES do
                if turtle.up() then
                    ok = true
                    break
                end
                if turtle.detectUp() then
                    turtle.digUp()
                else
                    turtle.attackUp()
                end
                sleep(0.2)
            end
        end

        if not ok then
            log("RETURN FAILED at route step " .. i)
            log("Stopped to avoid claiming the turtle returned home.")
            return false
        end
    end

    route = {}
    log("Return route completed.")
    return true
end

local function remainingSeconds()
    return RUN_TIME - (os.epoch("utc") - started) / 1000
end

local fuel = turtle.getFuelLevel()

if fuel ~= "unlimited" and fuel < MIN_FUEL then
    print("Not enough fuel to safely start.")
    print("Fuel: " .. tostring(fuel) .. " | Recommended minimum: " .. MIN_FUEL)
    return
end

log("Diamond scout started.")
log("Scanner: " .. scannerName)
log("Scan radius: " .. SCAN_RADIUS)
log("Mining time: " .. RUN_TIME .. " seconds.")

local stopReason = "Time limit reached"

while remainingSeconds() > 0 do
    if inventoryFull() then
        stopReason = "Inventory full"
        break
    end

    local targets = scanForDiamonds()

    if not targets then
        sleep(1)
    elseif #targets == 0 then
        log("No diamonds detected. Waiting before next scan.")
        sleep(1)
    else
        if not mineTarget(targets[1]) then
            stopReason = "Could not reach target or inventory full"
            break
        end
    end
end

log("Stopping: " .. stopReason)
log("Scans: " .. scans .. " | Targets reached: " .. mined)

local returned = reverseRoute()

print()
print("=== DIAMOND SCOUT REPORT ===")
print("Scans: " .. scans)
print("Target locations reached: " .. mined)
print("Stop reason: " .. stopReason)
print("Returned: " .. (returned and "Yes" or "NO - CHECK TURTLE"))
