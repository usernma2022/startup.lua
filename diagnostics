
-- Peripheral Inspector v4.0

local function clear()
    term.clear()
    term.setCursorPos(1, 1)
end

local function pause(message)
    print()
    write(message or "Press Enter to continue...")
    read()
end

local function findMonitor()
    for _, name in ipairs(peripheral.getNames()) do
        if peripheral.getType(name) == "monitor" then
            local ok, monitor = pcall(peripheral.wrap, name)
            if ok and monitor then
                return monitor, name
            end
        end
    end
    return nil, nil
end

local function addLines(value, lines, indent, seen, key)
    indent = indent or ""
    seen = seen or {}

    local prefix = key ~= nil and (tostring(key) .. " = ") or ""

    if type(value) ~= "table" then
        lines[#lines + 1] = indent .. prefix .. tostring(value)
        return
    end

    if seen[value] then
        lines[#lines + 1] = indent .. prefix .. "<circular reference>"
        return
    end

    seen[value] = true

    if next(value) == nil then
        lines[#lines + 1] = indent .. prefix .. "{}"
    else
        if key ~= nil then
            lines[#lines + 1] = indent .. prefix .. "{"
            indent = indent .. "  "
        end

        for k, v in pairs(value) do
            addLines(v, lines, indent, seen, k)
        end

        if key ~= nil then
            lines[#lines + 1] = indent:sub(1, math.max(0, #indent - 2)) .. "}"
        end
    end

    seen[value] = nil
end

local function wrapLine(line, width)
    local result = {}

    if width < 1 then
        return {line}
    end

    while #line > width do
        local cut = width
        local space = line:sub(1, width):match(".*()%s")

        if space and space > 1 then
            cut = space
        end

        result[#result + 1] = line:sub(1, cut)
        line = line:sub(cut + 1)
    end

    result[#result + 1] = line
    return result
end

local function displayOnMonitor(title, lines)
    local monitor, monitorName = findMonitor()

    if not monitor then
        print()
        print("No monitor connected. Showing output here:")
        print("--------------------------------")
        for _, line in ipairs(lines) do
            print(line)
        end
        return
    end

    local ok, err = pcall(function()
        monitor.setTextScale(0.5)
    end)

    local width, height = monitor.getSize()
    local displayLines = {}

    for _, line in ipairs(lines) do
        local wrapped = wrapLine(line, width)
        for _, part in ipairs(wrapped) do
            displayLines[#displayLines + 1] = part
        end
    end

    if #displayLines == 0 then
        displayLines[1] = "<No output>"
    end

    local pageSize = math.max(1, height - 2)
    local page = 1
    local totalPages = math.ceil(#displayLines / pageSize)

    while page <= totalPages do
        if not peripheral.isPresent(monitorName) then
            print("Monitor disconnected.")
            return
        end

        monitor.setBackgroundColor(colors.black)
        monitor.setTextColor(colors.white)
        monitor.clear()
        monitor.setCursorPos(1, 1)

        monitor.setTextColor(colors.cyan)
        monitor.write(title:sub(1, width))
        monitor.setTextColor(colors.white)

        local first = (page - 1) * pageSize + 1
        local last = math.min(first + pageSize - 1, #displayLines)

        for i = first, last do
            monitor.setCursorPos(1, i - first + 2)
            monitor.write(displayLines[i])
        end

        monitor.setCursorPos(1, height)
        monitor.setTextColor(colors.yellow)
        monitor.write(("Page %d/%d"):format(page, totalPages))

        if totalPages > 1 then
            clear()
            print(title)
            print("Monitor: " .. monitorName)
            print("Page " .. page .. " of " .. totalPages)
            print("Enter = next page, q = stop")
            write("> ")

            local input = read():lower()
            if input == "q" then
                break
            end
        else
            break
        end

        page = page + 1
    end

    monitor.setTextColor(colors.white)
    monitor.setCursorPos(1, height)
end

local function getInput(prompt)
    write(prompt)
    local value = read()

    if value == "nil" then
        return nil
    elseif value == "true" then
        return true
    elseif value == "false" then
        return false
    end

    local number = tonumber(value)
    if number ~= nil then
        return number
    end

    return value
end

local function chooseInputType()
    print()
    print("Input type:")
    print("1) Auto")
    print("2) Number")
    print("3) Text")
    print("4) Boolean")
    print("5) Nil")

    write("Type: ")
    local choice = read()

    if choice == "2" then
        while true do
            write("Number: ")
            local value = tonumber(read())
            if value ~= nil then
                return true, value
            end
            print("Enter a valid number.")
        end
    elseif choice == "3" then
        write("Text: ")
        return true, read()
    elseif choice == "4" then
        while true do
            write("Boolean (true/false): ")
            local value = read():lower()
            if value == "true" then
                return true, true
            elseif value == "false" then
                return true, false
            end
            print("Enter true or false.")
        end
    elseif choice == "5" then
        return true, nil
    else
        return true, getInput("Value: ")
    end
end

local function callMethod(p, method, name)
    print()
    print("Method: " .. method)
    print("Add arguments in the order the method expects.")
    print()

    local args = {n = 0}

    while true do
        write("Add argument? (y/n): ")
        local answer = read():lower()

        if answer ~= "y" and answer ~= "yes" then
            break
        end

        local present, value = chooseInputType()
        args.n = args.n + 1
        args[args.n] = value
        print("Argument " .. args.n .. " added.")
    end

    print()
    print("Calling method...")

    local results = table.pack(pcall(function()
        return p[method](table.unpack(args, 1, args.n))
    end))

    local lines = {}

    if not results[1] then
        lines[#lines + 1] = "CALL FAILED"
        lines[#lines + 1] = tostring(results[2])
    else
        lines[#lines + 1] = "Call succeeded."

        if results.n == 1 then
            lines[#lines + 1] = "No values returned."
        else
            for i = 2, results.n do
                lines[#lines + 1] = "Return value " .. (i - 1) .. ":"
                addLines(results[i], lines, "  ", {}, nil)
            end
        end
    end

    displayOnMonitor(name .. "." .. method, lines)

    print()
    print("Result:")
    for _, line in ipairs(lines) do
        print(line)
    end
end

while true do
    clear()
    print("=== Peripheral Inspector v4.0 ===")
    print()

    local names = peripheral.getNames()

    if #names == 0 then
        print("No peripherals found.")
        pause()
    else
        for i, name in ipairs(names) do
            print(i .. ") " .. name .. " (" ..
                tostring(peripheral.getType(name) or "?") .. ")")
        end

        print()
        write("Select peripheral number (q = quit): ")
        local choice = read()

        if choice:lower() == "q" then
            break
        end

        choice = tonumber(choice)

        if not choice or not names[choice] then
            print("Invalid selection.")
            pause()
        else
            local name = names[choice]

            while peripheral.isPresent(name) do
                local p = peripheral.wrap(name)
                clear()

                print("Peripheral: " .. name)
                print("Type: " .. tostring(peripheral.getType(name)))
                print()
                print("Methods:")

                local methods = peripheral.getMethods(name) or {}
                table.sort(methods)

                for i, method in ipairs(methods) do
                    print(i .. ") " .. method)
                end

                print()
                print("Enter method number or exact name.")
                print("r = refresh, b = back")
                write("Method: ")

                local input = read()

                if input:lower() == "b" then
                    break
                elseif input:lower() ~= "r" then
                    local method = tonumber(input)
                    if method then
                        method = methods[method]
                    end

                    local found = false
                    for _, candidate in ipairs(methods) do
                        if candidate == method then
                            found = true
                            break
                        end
                    end

                    if found then
                        clear()
                        callMethod(p, method, name)
                        pause()
                    else
                        print("Unknown method.")
                        pause()
                    end
                end
            end
        end
    end
end

clear()
print("Peripheral Inspector closed.")
