
-- Peripheral Inspector v5.0
-- Includes interactive dial / axis testing and monitor output.

local function clear()
    term.clear()
    term.setCursorPos(1, 1)
end

local function pause(message)
    print()
    write(message or "Press Enter to continue...")
    read()
end

local function findMonitor()
    for _, name in ipairs(peripheral.getNames()) do
        if peripheral.getType(name) == "monitor" then
            local ok, monitor = pcall(peripheral.wrap, name)
            if ok and monitor then
                return monitor, name
            end
        end
    end
    return nil, nil
end

local function addLines(value, lines, indent, seen, key)
    indent = indent or ""
    seen = seen or {}

    local prefix = key ~= nil and (tostring(key) .. " = ") or ""

    if type(value) ~= "table" then
        lines[#lines + 1] = indent .. prefix .. tostring(value)
        return
    end

    if seen[value] then
        lines[#lines + 1] = indent .. prefix .. "<circular reference>"
        return
    end

    seen[value] = true

    if next(value) == nil then
        lines[#lines + 1] = indent .. prefix .. "{}"
    else
        if key ~= nil then
            lines[#lines + 1] = indent .. prefix .. "{"
            indent = indent .. "  "
        end

        for k, v in pairs(value) do
            addLines(v, lines, indent, seen, k)
        end

        if key ~= nil then
            lines[#lines + 1] = indent:sub(1, math.max(0, #indent - 2)) .. "}"
        end
    end

    seen[value] = nil
end

local function wrapLine(line, width)
    local result = {}

    if width < 1 then
        return {line}
    end

    while #line > width do
        local cut = width
        local space = line:sub(1, width):match(".*()%s")

        if space and space > 1 then
            cut = space
        end

        result[#result + 1] = line:sub(1, cut)
        line = line:sub(cut + 1)
    end

    result[#result + 1] = line
    return result
end

local function displayOnMonitor(title, lines)
    local monitor, monitorName = findMonitor()

    if not monitor then
        print()
        print("No monitor connected. Output:")
        print("--------------------------------")
        for _, line in ipairs(lines) do
            print(line)
        end
        return
    end

    pcall(monitor.setTextScale, 0.5)

    local width, height = monitor.getSize()
    local displayLines = {}

    for _, line in ipairs(lines) do
        for _, part in ipairs(wrapLine(tostring(line), width)) do
            displayLines[#displayLines + 1] = part
        end
    end

    if #displayLines == 0 then
        displayLines[1] = "<No output>"
    end

    local pageSize = math.max(1, height - 2)
    local totalPages = math.ceil(#displayLines / pageSize)

    for page = 1, totalPages do
        if not peripheral.isPresent(monitorName) then
            print("Monitor disconnected.")
            return
        end

        monitor.setBackgroundColor(colors.black)
        monitor.setTextColor(colors.white)
        monitor.clear()
        monitor.setCursorPos(1, 1)
        monitor.setTextColor(colors.cyan)
        monitor.write(title:sub(1, width))
        monitor.setTextColor(colors.white)

        local first = (page - 1) * pageSize + 1
        local last = math.min(first + pageSize - 1, #displayLines)

        for i = first, last do
            monitor.setCursorPos(1, i - first + 2)
            monitor.write(displayLines[i])
        end

        monitor.setCursorPos(1, height)
        monitor.setTextColor(colors.yellow)
        monitor.write(("Page %d/%d"):format(page, totalPages))

        if page < totalPages then
            clear()
            print(title)
            print("Monitor: " .. monitorName)
            print("Page " .. page .. " of " .. totalPages)
            print("Enter = next page, q = stop")
            write("> ")

            if read():lower() == "q" then
                break
            end
        end
    end

    monitor.setTextColor(colors.white)
end

local function showResult(title, ok, result)
    local lines = {}

    if not ok then
        lines[#lines + 1] = "CALL FAILED"
        addLines(result, lines, "  ", {}, nil)
    else
        lines[#lines + 1] = "Call succeeded."

        if result.n <= 1 then
            lines[#lines + 1] = "No values returned."
        else
            for i = 2, result.n do
                lines[#lines + 1] = "Return value " .. (i - 1) .. ":"
                addLines(result[i], lines, "  ", {}, nil)
            end
        end
    end

    displayOnMonitor(title, lines)

    print()
    print("Result:")
    for _, line in ipairs(lines) do
        print(line)
    end
end

local function invoke(p, method, ...)
    local args = table.pack(...)

    return table.pack(pcall(function()
        return p[method](table.unpack(args, 1, args.n))
    end))
end

local function getInput(prompt)
    write(prompt)
    local value = read()

    if value == "nil" then
        return nil
    elseif value == "true" then
        return true
    elseif value == "false" then
        return false
    end

    return tonumber(value) or value
end

local function chooseInputType()
    print()
    print("Input type:")
    print("1) Auto")
    print("2) Number")
    print("3) Text")
    print("4) Boolean")
    print("5) Nil")
    write("Type: ")

    local choice = read()

    if choice == "2" then
        while true do
            write("Number: ")
            local value = tonumber(read())
            if value ~= nil then
                return true, value
            end
            print("Enter a valid number.")
        end
    elseif choice == "3" then
        write("Text: ")
        return true, read()
    elseif choice == "4" then
        while true do
            write("Boolean (true/false): ")
            local value = read():lower()
            if value == "true" then return true, true end
            if value == "false" then return true, false end
            print("Enter true or false.")
        end
    elseif choice == "5" then
        return true, nil
    end

    return true, getInput("Value: ")
end

local function callMethod(p, method, name)
    print()
    print("Method: " .. method)
    print("Add arguments in the order the method expects.")
    local args = {n = 0}

    while true do
        write("Add argument? (y/n): ")
        local answer = read():lower()

        if answer ~= "y" and answer ~= "yes" then
            break
        end

        local _, value = chooseInputType()
        args.n = args.n + 1
        args[args.n] = value
        print("Argument " .. args.n .. " added.")
    end

    print("Calling method...")
    local result = invoke(p, method, table.unpack(args, 1, args.n))
    showResult(name .. "." .. method, result[1], result)
end

local function hasMethod(methods, target)
    for _, method in ipairs(methods) do
        if method == target then
            return true
        end
    end
    return false
end

local function readNumber(prompt, default)
    while true do
        write(prompt)
        local input = read()

        if input == "" and default ~= nil then
            return default
        end

        local value = tonumber(input)
        if value ~= nil then
            return value
        end

        print("Enter a valid number.")
    end
end

local function dialTester(p, name, methods)
    if not hasMethod(methods, "setAngle") then
        print("This peripheral does not expose setAngle().")
        pause()
        return
    end

    local hasGetAngle = hasMethod(methods, "getAngle")
    local hasStopAuto = hasMethod(methods, "stopAuto")

    clear()
    print("=== Dial / Axis Tester ===")
    print("Peripheral: " .. name)
    print()
    print("Select setAngle() argument format:")
    print("1) setAngle(angle)")
    print("2) setAngle(yaw, pitch)")
    print("3) setAngle(pitch, yaw)")
    print()
    print("Choose the format that matches the peripheral API.")
    print("If unsure, inspect its documentation first.")
    write("Format: ")

    local format = read()

    if format ~= "1" and format ~= "2" and format ~= "3" then
        print("Invalid format.")
        pause()
        return
    end

    local yaw = 0
    local pitch = 0
    local singleAngle = 0
    local activeAxis = "yaw"
    local step = 1

    if format == "2" or format == "3" then
        yaw = readNumber("Initial yaw value [0]: ", 0)
        pitch = readNumber("Initial pitch value [0]: ", 0)
    else
        singleAngle = readNumber("Initial angle value [0]: ", 0)
        print()
        print("For one-argument mode, axis labels are only for your notes.")
        print("The controller decides which axis setAngle(angle) affects.")
    end

    local function setCurrentAngle()
        local result

        if format == "1" then
            result = invoke(p, "setAngle", singleAngle)
        elseif format == "2" then
            result = invoke(p, "setAngle", yaw, pitch)
        else
            result = invoke(p, "setAngle", pitch, yaw)
        end

        showResult(name .. ".setAngle", result[1], result)
    end

    local function readCurrentAngle()
        if not hasGetAngle then
            print("getAngle() is not available.")
            displayOnMonitor("Dial / Axis Tester", {
                "getAngle() is not available.",
                "Peripheral: " .. name
            })
            return
        end

        local result = invoke(p, "getAngle")
        showResult(name .. ".getAngle", result[1], result)
    end

    while peripheral.isPresent(name) do
        clear()
        print("=== Dial / Axis Tester ===")
        print("Peripheral: " .. name)
        print("Format: " .. format)

        if format == "1" then
            print("Selected label: " .. activeAxis)
            print("Angle value: " .. singleAngle)
        else
            print("Yaw: " .. yaw)
            print("Pitch: " .. pitch)
        end

        print("Step: " .. step)
        print()
        print("1) Select yaw")
        print("2) Select pitch")
        print("3) Increase selected angle")
        print("4) Decrease selected angle")
        print("5) Change step size")
        print("6) Enter selected angle")
        print("7) Send current angle(s) to setAngle()")
        print("8) Read getAngle()")
        if hasStopAuto then
            print("9) Call stopAuto()")
        end
        print("b) Back")
        print()
        write("Choice: ")

        local choice = read():lower()

        if choice == "b" then
            break
        elseif choice == "1" then
            activeAxis = "yaw"
        elseif choice == "2" then
            activeAxis = "pitch"
        elseif choice == "3" or choice == "4" or choice == "6" then
            local change = choice == "3" and step or choice == "4" and -step or nil

            if format == "1" then
                if choice == "6" then
                    singleAngle = readNumber("New angle: ", singleAngle)
                else
                    singleAngle = singleAngle + change
                end
            elseif activeAxis == "yaw" then
                if choice == "6" then
                    yaw = readNumber("New yaw: ", yaw)
                else
                    yaw = yaw + change
                end
            else
                if choice == "6" then
                    pitch = readNumber("New pitch: ", pitch)
                else
                    pitch = pitch + change
                end
            end

            print("Updated locally. Use option 7 to send it.")
            pause()
        elseif choice == "5" then
            step = readNumber("New step size: ", step)
            if step <= 0 then
                step = 1
                print("Step must be positive; reset to 1.")
                pause()
            end
        elseif choice == "7" then
            setCurrentAngle()
            pause()
        elseif choice == "8" then
            readCurrentAngle()
            pause()
        elseif choice == "9" and hasStopAuto then
            local result = invoke(p, "stopAuto")
            showResult(name .. ".stopAuto", result[1], result)
            pause()
        else
            print("Unknown option.")
            pause()
        end
    end
end

while true do
    clear()
    print("=== Peripheral Inspector v5.0 ===")
    print()
    local names = peripheral.getNames()

    if #names == 0 then
        print("No peripherals found.")
        pause()
    else
        for i, name in ipairs(names) do
            print(i .. ") " .. name .. " (" ..
                tostring(peripheral.getType(name) or "?") .. ")")
        end

        print()
        write("Select peripheral number (q = quit): ")
        local choice = read()

        if choice:lower() == "q" then
            break
        end

        choice = tonumber(choice)

        if not choice or not names[choice] then
            print("Invalid selection.")
            pause()
        else
            local name = names[choice]

            while peripheral.isPresent(name) do
                local p = peripheral.wrap(name)
                local methods = peripheral.getMethods(name) or {}
                table.sort(methods)

                clear()
                print("Peripheral: " .. name)
                print("Type: " .. tostring(peripheral.getType(name)))
                print()
                print("Methods:")

                for i, method in ipairs(methods) do
                    print(i .. ") " .. method)
                end

                print()
                print("Enter method number or exact name.")
                print("d = Dial / Axis Tester")
                print("r = refresh, b = back")
                write("Method: ")

                local input = read()
                local lower = input:lower()

                if lower == "b" then
                    break
                elseif lower == "d" then
                    dialTester(p, name, methods)
                elseif lower ~= "r" then
                    local method = tonumber(input)
                    if method then
                        method = methods[method]
                    end

                    if method and hasMethod(methods, method) then
                        clear()
                        callMethod(p, method, name)
                        pause()
                    else
                        print("Unknown method.")
                        pause()
                    end
                end
            end
        end
    end
end

clear()
print("Peripheral Inspector closed.")
