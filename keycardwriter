-- AEGIS Security Server v8.0

local MODEM_SIDE = "left"
local CHANNEL = 25

local DATABASE = "cards.db"
local LOGFILE = "access.log"

local OWNER = "Usernam_"

local modem = peripheral.wrap(MODEM_SIDE)
local drive = peripheral.find("drive")
local detector = peripheral.find("playerDetector")

if not modem then
    error("No modem found")
end

if not detector then
    error("No player detector found")
end

modem.open(CHANNEL)

math.randomseed(os.epoch("utc"))

local HEX = "0123456789ABCDEF"
local facilityActive = false


local function randomHex(length)
    local s = ""

    for i = 1,length do
        local n = math.random(#HEX)
        s = s .. HEX:sub(n,n)
    end

    return s
end


local function generateID()
    return randomHex(8).."-"..
           randomHex(4).."-"..
           randomHex(4).."-"..
           randomHex(4).."-"..
           randomHex(12)
end


local function loadDatabase()

    if fs.exists(DATABASE) then

        local f = fs.open(DATABASE,"r")

        local data =
            textutils.unserialize(
                f.readAll()
            )

        f.close()

        return data or {}
    end

    return {}
end


local cards = loadDatabase()


local function saveDatabase()

    local f = fs.open(DATABASE,"w")

    f.write(
        textutils.serialize(cards)
    )

    f.close()
end


local function log(text)

    local f = fs.open(LOGFILE,"a")

    f.writeLine(
        "["..
        os.date("%Y-%m-%d %H:%M:%S")..
        "] "..text
    )

    f.close()
end


local function checkOwner()

    for _,player in pairs(
        detector.getOnlinePlayers()
    ) do

        if player == OWNER then
            return true
        end

    end

    return false
end


local function securityLoop()

    while true do

        local previous = facilityActive

        facilityActive = checkOwner()

        if previous ~= facilityActive then

            if facilityActive then

                log(
                    "FACILITY ONLINE - OWNER PRESENT"
                )

            else

                log(
                    "FACILITY OFFLINE - OWNER LEFT"
                )

            end

        end

        sleep(5)
    end
end


local function writeCard(id,data)

    if not drive then

        print("No floppy drive attached")

        return false
    end


    if not drive.isDiskPresent() then

        print("Insert floppy")

        return false
    end


    local diskID = drive.getDiskID()

    if not diskID then

        print("ERROR: Disk has no ID")

        return false
    end


    local mount = drive.getMountPath()


    local function writeFile(name,value)

        local f =
            fs.open(
                fs.combine(mount,name),
                "w"
            )

        f.write(value)
        f.close()

    end


    writeFile(
        "auth.dat",
        id
    )


    writeFile(
        "security.dat",
        textutils.serialize({
            clearance =
                data.security.clearance,
            version = 8
        })
    )


    writeFile(
        "card.dat",
        textutils.serialize({
            owner =
                data.card.owner,

            issued =
                data.card.issued,

            issuer =
                "AEGIS"
        })
    )


    cards[id].diskID = diskID

    saveDatabase()

    return true
end


local function createCard()

    term.clear()
    term.setCursorPos(1,1)

    print("CREATE CARD")
    print()

    write("Owner: ")
    local owner = read()

    write("Clearance 1-5: ")
    local clearance = tonumber(read())

    if not clearance or clearance < 1 or clearance > 5 then

        print("Invalid clearance")
        sleep(2)

        return
    end


    if not drive then

        print("No floppy drive attached")
        sleep(2)

        return
    end


    if not drive.isDiskPresent() then

        print("Insert floppy")
        sleep(2)

        return
    end


    local diskID = drive.getDiskID()

    if not diskID then

        print("ERROR: Disk has no ID")
        print("Card will not be issued.")

        sleep(3)

        return
    end


    local id

    repeat

        id = generateID()

    until not cards[id]


    cards[id] = {

        security = {

            clearance = clearance,
            version = 8

        },


        card = {

            owner = owner,
            issued =
                os.date("%Y-%m-%d %H:%M:%S"),
            issuer = "AEGIS"

        },


        diskID = diskID,

        status = "active"

    }


    saveDatabase()


    print()
    print("Card registered")
    print(id)

    print()
    print("Physical Disk ID:")
    print(diskID)

    print()
    print("Write floppy? Y/N")


    if read():lower()=="y" then

        if writeCard(id,cards[id]) then

            print("Card written")

        end

    end


    log(
        "CREATED "..id..
        " OWNER "..owner..
        " DISK "..diskID
    )


    sleep(3)
end


local function getCardList(status)

    local list = {}

    for id,c in pairs(cards) do

        if c.status == status then

            table.insert(list,{
                id = id,
                card = c
            })

        end

    end


    table.sort(list,function(a,b)

        return a.card.card.owner <
               b.card.card.owner

    end)


    return list
end


local function scrollList(title,list,action)

    local selected = 1
    local scroll = 1

    local visible = 5


    while true do

        term.clear()
        term.setCursorPos(1,1)

        print("======== AEGIS ========")
        print(title)
        print()


        if #list == 0 then

            print("No cards.")
            print()
            print("Press any key...")

            os.pullEvent("key")

            return
        end


        if selected < scroll then
            scroll = selected
        end


        if selected >= scroll + visible then
            scroll = selected - visible + 1
        end


        for i = scroll,
            math.min(
                #list,
                scroll + visible - 1
            ) do

            local entry = list[i]
            local c = entry.card

            if i == selected then
                term.setTextColor(colors.yellow)
            else
                term.setTextColor(colors.white)
            end

            print(
                i..") "..c.card.owner
            )

            term.setTextColor(colors.gray)

            print(
                "   "..entry.id
            )

            print(
                "   Level "..c.security.clearance..
                " | "..c.status
            )

            print()

        end


        term.setTextColor(colors.lightGray)

        print(
            "Scroll | Enter select | Q back"
        )


        local event,a,b,c,d =
            os.pullEvent()


        if event == "mouse_scroll" then

            if a > 0 then

                selected =
                    math.min(
                        selected + 1,
                        #list
                    )

            else

                selected =
                    math.max(
                        selected - 1,
                        1
                    )

            end


        elseif event == "key" then

            if a == keys.q then

                return

            elseif a == keys.enter then

                action(
                    list[selected].id,
                    list[selected].card
                )

                return

            end

        end

    end
end


local function viewCards()

    local list =
        getCardList("active")


    scrollList(
        "ACTIVE CARDS",
        list,
        function(id,c)

            term.clear()
            term.setCursorPos(1,1)

            print("CARD INFORMATION")
            print()

            print("Owner: "..c.card.owner)
            print("Card ID: "..id)
            print(
                "Clearance: "..
                c.security.clearance
            )

            print(
                "Status: "..c.status
            )

            print(
                "Issued: "..c.card.issued
            )

            print(
                "Disk ID: "..
                tostring(c.diskID or "NONE")
            )

            print()
            print("Press any key...")

            os.pullEvent("key")

        end
    )
end


local function revoke()

    local list =
        getCardList("active")


    scrollList(
        "REVOKE CARD",
        list,
        function(id,c)

            term.clear()
            term.setCursorPos(1,1)

            print("REVOKE CARD")
            print()

            print("Owner: "..c.card.owner)
            print("Card ID: "..id)

            print()
            print("Revoke this card? Y/N")

            if read():lower()=="y" then

                cards[id].status = "revoked"

                saveDatabase()


                log(
                    "REVOKED "..id
                )


                print()
                print("Card revoked")

                sleep(2)

            end

        end
    )
end


local function restore()

    local list =
        getCardList("revoked")


    scrollList(
        "RESTORE CARD",
        list,
        function(id,c)

            term.clear()
            term.setCursorPos(1,1)

            print("RESTORE CARD")
            print()

            print("Owner: "..c.card.owner)
            print("Card ID: "..id)

            print()
            print("Restore this card? Y/N")

            if read():lower()=="y" then

                cards[id].status = "active"

                saveDatabase()


                log(
                    "RESTORED "..id
                )


                print()
                print("Card restored")

                sleep(2)

            end

        end
    )
end


local function status()

    term.clear()
    term.setCursorPos(1,1)

    print("AEGIS STATUS")
    print()


    if facilityActive then

        print("Facility: ONLINE")
        print("Owner detected")

    else

        print("Facility: OFFLINE")
        print("Owner not detected")

    end


    print()

    read()
end


local function network()

    while true do

        local _,_,channel,_,msg =
            os.pullEvent("modem_message")


        if channel == CHANNEL
        and type(msg)=="table"
        and msg.type=="check_card" then


            local card =
                cards[msg.id]


            local reply = {

                type="card_result",

                request=msg.request,

                allowed=false

            }


            if not facilityActive then

                reply.reason =
                    "Facility Offline"


                log(
                    "DENIED OFFLINE "..tostring(msg.id)
                )


            elseif not card then

                reply.reason =
                    "Invalid Card"


                log(
                    "DENIED INVALID "..tostring(msg.id)
                )


            elseif card.status ~= "active" then

                reply.reason =
                    "Card Revoked"


                log(
                    "DENIED REVOKED "..msg.id
                )


            elseif not card.diskID then

                reply.reason =
                    "Card Not Bound"


                log(
                    "DENIED UNBOUND "..msg.id
                )


            elseif not msg.diskID then

                reply.reason =
                    "No Disk ID"


                log(
                    "DENIED NO DISK ID "..msg.id
                )


            elseif tostring(card.diskID)
                ~= tostring(msg.diskID) then

                reply.reason =
                    "Invalid Card"


                log(
                    "DENIED DISK MISMATCH "..msg.id..
                    " EXPECTED "..tostring(card.diskID)..
                    " GOT "..tostring(msg.diskID)
                )


            elseif card.security.clearance
                < msg.required then

                reply.reason =
                    "Insufficient Clearance"


                log(
                    "DENIED CLEARANCE "..msg.id
                )


            else

                reply.allowed = true

                reply.owner =
                    card.card.owner

                reply.clearance =
                    card.security.clearance


                log(
                    "ACCESS "..msg.id..
                    " DISK "..tostring(msg.diskID)
                )

            end


            modem.transmit(
                CHANNEL,
                CHANNEL,
                reply
            )

        end

    end
end


local function menu()

    while true do

        term.clear()
        term.setCursorPos(1,1)

        print("======== AEGIS ========")
        print()

        print("1. View Cards")
        print("2. Create Card")
        print("3. Revoke Card")
        print("4. Restore Card")
        print("5. Facility Status")
        print("6. Exit")

        print()

        local c = read()


        if c=="1" then

            viewCards()

        elseif c=="2" then

            createCard()

        elseif c=="3" then

            revoke()

        elseif c=="4" then

            restore()

        elseif c=="5" then

            status()

        elseif c=="6" then

            error("Shutdown")

        end

    end
end


parallel.waitForAny(

    network,

    menu,

    securityLoop

)
